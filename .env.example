# --- Servidor ---
NODE_ENV=development
PORT=4000
# Confianza en proxies para obtener la IP real del cliente (rate-limit / audit logs).
# "false" (por defecto, sin proxy). Detrás de un CDN/proxy (Render, Cloudflare...) pon
# el nº de saltos de confianza, p. ej. "1". NUNCA "true" en producción (XFF falsificable).
TRUST_PROXY=false
# Origen(es) permitidos por CORS. Acepta varios separados por comas.
# En producción NO puede ser "*" (el arranque abortará): pon el dominio real del frontend.
# Ej.: CORS_ORIGIN="https://nottoday.com,https://www.nottoday.com"
CORS_ORIGIN=http://localhost:3000

# --- Base de datos (PostgreSQL) ---
# Usa credenciales propias y fuertes; no reutilices el usuario/clave de ejemplo.
DATABASE_URL="postgresql://nottoday:nottoday@localhost:5432/nottoday_db?schema=public"

# --- Redis (cache de catálogo + colas BullMQ) ---
# Contenedor dedicado del proyecto: docker run -d --name nottoday-redis --restart unless-stopped -p 6390:6379 redis:7-alpine
REDIS_URL="redis://localhost:6390"

# --- Autenticación ---
# OBLIGATORIO: mínimo 32 caracteres y aleatorio. Genera uno con: openssl rand -hex 32
# No se admiten valores placeholder (dev-, cambiar, changeme, ...) en producción.
JWT_SECRET="change-this-to-a-long-random-secret-min-32-chars"
JWT_EXPIRES_IN="8h"

# --- Stripe (Apple Pay / Google Pay via Payment Request Button) ---
STRIPE_SECRET_KEY="sk_test_xxx"
# OBLIGATORIO en producción: sin él ningún pago puede confirmarse (única fuente de verdad).
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# Solo desarrollo/pruebas: "true" salta Stripe en el checkout y marca el pedido como
# PAGADO automáticamente (simula la web completa sin claves reales).
# El arranque ABORTA si se pone a "true" con NODE_ENV=production.
CHECKOUT_SKIP_STRIPE="false"

# --- Cloudinary (subida de imágenes desde el panel) ---
# Créalas gratis en https://cloudinary.com (Dashboard → Product Environment Credentials).
# Sin ellas, el botón de adjuntar foto devuelve un error de "no configurado".
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Emails transaccionales (Resend: https://resend.com) ---
# Interruptor general: con "false" (por defecto) no sale NINGÚN correo, solo se registran en el log.
EMAILS_ENABLED="false"
# URL pública de la web: se usa en los enlaces e imágenes (QR) de los emails.
APP_URL="http://localhost:4000"
# Sin clave los emails NO se envían: solo se registran en el log (útil en local).
# Para enviar desde tu dominio, verifícalo en Resend (DNS) antes de usarlo en EMAIL_FROM.
RESEND_API_KEY=""
EMAIL_FROM="NOT TODAY <no-reply@nottoday.com>"
# Buzón del equipo: recibe el aviso de cada booking nuevo y las respuestas de los clientes.
EMAIL_REPLY_TO=""

# --- Impuestos ---
# IVA del envío (cada producto tiene el suyo en el panel). Precios siempre con IVA incluido.
SHIPPING_TAX_RATE=21

# --- Seed del admin inicial (prisma:seed) ---
# OBLIGATORIO para sembrar: sin SEED_ADMIN_PASSWORD el seed aborta (no hay clave por defecto).
SEED_ADMIN_EMAIL="admin@nottoday.com"
SEED_ADMIN_PASSWORD=""

# --- Workers ---
ABANDONED_CART_CRON="0 */2 * * *"
ABANDONED_CART_THRESHOLD_HOURS=2

# Expiración de pedidos PENDIENTE sin pagar (libera la reserva de stock).
# El TTL debe superar la ventana de pago de Stripe (~15-20 min) para no cancelar
# pedidos que el cliente aún está pagando.
PENDING_ORDER_CRON="*/5 * * * *"
PENDING_ORDER_TTL_MINUTES=30
