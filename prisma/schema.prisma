// ============================================================================
// NOTTODAY — Esquema de datos principal
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// 1. USUARIOS Y ROLES
// ----------------------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
  ARTISTA
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // hash bcrypt, nunca texto plano
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un usuario con rol ARTISTA puede estar vinculado a su ficha pública de Artista
  artist              Artist?
  carts               Cart[]
  auditLogs           AuditLog[]
  newsletterCampaigns NewsletterCampaign[]
  checkedInTickets    Ticket[]

  @@index([role])
}

// ----------------------------------------------------------------------------
// 2. ARTISTAS
// ----------------------------------------------------------------------------

enum ArtistStatus {
  ACTIVO
  INACTIVO
}

model Artist {
  id           String       @id @default(cuid())
  stageName    String
  bio          String?      @db.Text
  spotifyId    String?
  soundcloudId String?
  instagram    String?
  youtube      String? // URL del canal/perfil de YouTube del artista
  images       String[]     @default([])
  status       ArtistStatus @default(ACTIVO)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  lineups  EventLineup[]
  bookings Booking[]
  sessions Session[]

  @@index([status])
}

// ----------------------------------------------------------------------------
// 2b. N-TY SESSIONS (sesiones grabadas, alojadas en YouTube)
// ----------------------------------------------------------------------------

model Session {
  id          String   @id @default(cuid())
  title       String // "N-TY Session 001"
  youtubeUrl  String // URL completa del vídeo en YouTube
  description String?  @db.Text
  publishedAt DateTime @default(now())
  artistId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
  @@index([artistId])
}

// ----------------------------------------------------------------------------
// 2c. N-TY RADIO (parrilla semanal + playlist por franja)
// ----------------------------------------------------------------------------

enum Weekday {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

model RadioShow {
  id        String   @id @default(cuid())
  title     String // "BLOQUE CERO"
  host      String // texto libre: no todo host está en el roster de Artist
  dayOfWeek Weekday
  startTime String // "HH:mm" 24h, validado por regex en el schema zod
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tracks RadioTrack[]

  @@index([dayOfWeek, startTime])
}

model RadioTrack {
  id              String   @id @default(cuid())
  radioShowId     String
  title           String
  artist          String
  audioUrl        String // Cloudinary (subida) o URL externa pegada
  durationSeconds Int // necesario para calcular el "ahora suena" sincronizado
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  radioShow RadioShow @relation(fields: [radioShowId], references: [id], onDelete: Cascade)

  @@index([radioShowId, sortOrder])
}

// ----------------------------------------------------------------------------
// 3. EVENTOS (con line-up de artistas invitados)
// ----------------------------------------------------------------------------

enum EventStatus {
  BORRADOR
  PUBLICADO
  CANCELADO
  FINALIZADO
}

model Event {
  id                 String      @id @default(cuid())
  title              String
  date               DateTime
  venue              String
  description        String?     @db.Text
  posterUrl          String?
  price              Decimal     @default(0) @db.Decimal(10, 2)
  // Aforo total. Con aforo (y precio) el evento vende entradas: al guardarlo se
  // crea/actualiza su producto TICKET_EVENTO, cuyo stock es aforo - vendidas.
  capacity           Int?
  // Máximo de entradas por email de compra (null = sin límite).
  maxTicketsPerEmail Int?
  // Nominativas: el checkout pide el nombre de cada asistente y va en la entrada.
  nominativeTickets  Boolean     @default(false)
  status             EventStatus @default(BORRADOR)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  lineup        EventLineup[]
  tickets       Ticket[]
  // Producto de tipo TICKET_EVENTO que vende la entrada de este evento (1:1,
  // igual que DropMetadata <-> Product). Null hasta que el admin crea el ticket.
  ticketProduct Product?

  @@index([date])
  @@index([status])
}

// Tabla puente explícita Evento <-> Artista (permite añadir orden de actuación, hora, etc.)
model EventLineup {
  id       String    @id @default(cuid())
  eventId  String
  artistId String
  setTime  DateTime?
  billing  Int       @default(0) // 0 = headliner, mayor número = menor jerarquía en el cartel

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([eventId, artistId])
  @@index([eventId])
  @@index([artistId])
}

// ----------------------------------------------------------------------------
// 4. PRODUCTOS (Tienda general vs Drops exclusivos) + Inventario por talla
// ----------------------------------------------------------------------------

enum ProductType {
  TIENDA_GENERAL
  DROP_EXCLUSIVO
  TICKET_EVENTO
}

enum ProductStatus {
  BORRADOR
  ACTIVO
  AGOTADO
}

// Categorías del catálogo (camisetas, sudaderas, vinilos, pósters...).
model Category {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?  @db.Text
  seoTitle       String?
  seoDescription String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@index([sortOrder])
}

model Product {
  id             String        @id @default(cuid())
  name           String
  // URL amigable y estable (/producto/<slug>): se genera del nombre al crear.
  slug           String        @unique
  description    String?       @db.Text
  // Precio de venta al público, IVA INCLUIDO.
  price          Decimal       @db.Decimal(10, 2)
  // Tipo de IVA aplicable (21 general, 10 reducido, 4 superreducido, 0 exento).
  taxRate        Decimal       @default(21) @db.Decimal(5, 2)
  // Peso de envío por unidad (para las tarifas por peso). 0 = no cuenta.
  weightGrams    Int           @default(0)
  images         String[]      @default([])
  productType    ProductType   @default(TIENDA_GENERAL)
  status         ProductStatus @default(BORRADOR)
  seoTitle       String?
  seoDescription String?
  // Texto de búsqueda normalizado (minúsculas, sin acentos): nombre +
  // descripción + categoría. Lo mantiene la app al guardar (ver normalizeSearch).
  searchText     String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  variants           ProductVariant[]
  dropMeta           DropMetadata?
  cartItems          CartItem[]
  orderItems         OrderItem[]
  stockNotifications StockNotification[]

  // Solo se usa (y es obligatorio) cuando productType = TICKET_EVENTO: liga
  // el producto-ticket a su evento. Único -> como mucho un ticket por evento.
  eventId String? @unique
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([productType, status])
  @@index([categoryId])
}

// Metadatos exclusivos para productos tipo DROP_EXCLUSIVO (cuenta atrás / apertura)
enum DropStatus {
  PROXIMAMENTE
  ABIERTO
  FINALIZADO
}

model DropMetadata {
  id         String     @id @default(cuid())
  productId  String     @unique
  releaseAt  DateTime // fecha/hora de lanzamiento -> alimenta la cuenta atrás en el frontend
  dropStatus DropStatus @default(PROXIMAMENTE)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([dropStatus, releaseAt])
}

// Inventario por variante — la unidad real de stock/reserva/checkout.
// `size` es texto libre ("XS", "XXL", "42", "Única", "12 pulgadas"...) y
// `color` opcional ("" = sin color). "GENERAL" es la única variante de un
// producto TICKET_EVENTO, donde stockAvailable = aforo del evento.
model ProductVariant {
  id                String    @id @default(cuid())
  productId         String
  size              String
  color             String    @default("")
  sku               String?
  sortOrder         Int       @default(0)
  // Una variante retirada deja de venderse pero se conserva: los pedidos
  // antiguos la referencian (borrarla arrastraría sus líneas de pedido).
  active            Boolean   @default(true)
  stockAvailable    Int       @default(0)
  stockReserved     Int       @default(0)
  // Se marca al enviar la alerta de stock bajo; se limpia al reponer.
  lowStockAlertedAt DateTime?
  updatedAt         DateTime  @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  stockNotifications StockNotification[]

  @@unique([productId, size, color])
  @@index([productId])
}

// ----------------------------------------------------------------------------
// AVISOS DE REPOSICIÓN / LISTA DE ESPERA DE DROPS
// ----------------------------------------------------------------------------

enum StockNotificationStatus {
  PENDIENTE
  NOTIFICADO
  CANCELADO
}

// "Avísame": para una variante agotada (reposición) o para un drop que aún no
// ha salido (productVariantId null = cualquier variante / apertura del drop).
model StockNotification {
  id               String                  @id @default(cuid())
  email            String
  productId        String
  productVariantId String?
  status           StockNotificationStatus @default(PENDIENTE)
  consentIp        String?
  createdAt        DateTime                @default(now())
  notifiedAt       DateTime?

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([productVariantId, status])
}

// ----------------------------------------------------------------------------
// 5. DESCUENTOS Y CUPONES
// ----------------------------------------------------------------------------

enum DiscountType {
  PORCENTAJE
  MONTO_FIJO
  ENVIO_GRATIS
}

enum DiscountStatus {
  ACTIVO
  INACTIVO
}

model Discount {
  id                String         @id @default(cuid())
  code              String         @unique
  type              DiscountType
  value             Decimal        @db.Decimal(10, 2) // ignorado si type = ENVIO_GRATIS
  startDate         DateTime
  endDate           DateTime
  maxUses           Int?
  currentUses       Int            @default(0)
  minPurchaseAmount Decimal        @default(0) @db.Decimal(10, 2)
  status            DiscountStatus @default(ACTIVO)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  carts  Cart[]
  orders Order[]

  @@index([code])
  @@index([status, startDate, endDate])
}

// ----------------------------------------------------------------------------
// 6. CARRITOS Y SESIONES
// ----------------------------------------------------------------------------

enum CartStatus {
  ACTIVO
  ABANDONADO
  CONVERTIDO
}

model Cart {
  id                  String     @id @default(cuid())
  userId              String?
  email               String?
  discountCodeId      String?
  status              CartStatus @default(ACTIVO)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  // marca de la última vez que se notificó al cliente por carrito abandonado
  abandonedNotifiedAt DateTime?

  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  discountCode Discount?  @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  items        CartItem[]

  @@index([status, updatedAt])
  @@index([userId])
}

model CartItem {
  id               String @id @default(cuid())
  cartId           String
  productId        String
  productVariantId String
  quantity         Int    @default(1)

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
}

// ----------------------------------------------------------------------------
// MÉTODOS DE ENVÍO (definidos por el admin en su panel: tipo + coste)
// ----------------------------------------------------------------------------

// Zona de envío: conjunto de países (ISO 3166-1 alfa-2). `restOfWorld` recoge
// cualquier país no incluido en otra zona. `taxExempt`: exportación fuera de
// la UE, los productos físicos se venden sin IVA.
model ShippingZone {
  id          String   @id @default(cuid())
  name        String
  countries   String[] @default([])
  restOfWorld Boolean  @default(false)
  taxExempt   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  methods ShippingMethod[]
}

model ShippingMethod {
  id              String   @id @default(cuid())
  name            String // "Estándar 48/72h"
  description     String?
  // Precio base (IVA incluido): cubre el primer kilo.
  price           Decimal  @db.Decimal(10, 2)
  // Suplemento por cada kilo (o fracción) por encima del primero.
  pricePerExtraKg Decimal  @default(0) @db.Decimal(10, 2)
  // Peso máximo admitido; null = sin límite.
  maxWeightGrams  Int?
  // Envío gratis a partir de este importe de productos; null = nunca.
  freeOverAmount  Decimal? @db.Decimal(10, 2)
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // null = disponible para cualquier país.
  zoneId String?
  zone   ShippingZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  orders Order[]

  @@index([active, sortOrder])
}

// ----------------------------------------------------------------------------
// PEDIDOS (resultado del checkout — necesario para Stripe + trazabilidad de stock)
// ----------------------------------------------------------------------------

enum OrderStatus {
  PENDIENTE
  PAGADO
  FALLIDO
  CANCELADO
  REEMBOLSADO
}

// Estado logístico del pedido, independiente del estado del pago.
enum FulfillmentStatus {
  PENDIENTE
  ENVIADO
  ENTREGADO
}

model Order {
  id                    String      @id @default(cuid())
  userId                String?
  email                 String
  subtotal              Decimal     @db.Decimal(10, 2)
  discountAmount        Decimal     @default(0) @db.Decimal(10, 2)
  total                 Decimal     @db.Decimal(10, 2)
  discountCodeId        String?
  status                OrderStatus @default(PENDIENTE)
  stripePaymentIntentId String?     @unique
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // --- Envío: snapshot del método (nombre/coste cobrados) + dirección ---
  shippingMethodId   String?
  shippingMethodName String?
  shippingCost       Decimal @default(0) @db.Decimal(10, 2)
  shippingName       String?
  shippingAddress    String?
  shippingCity       String?
  shippingPostalCode String?
  shippingCountry    String?
  shippingPhone      String?

  fulfillmentStatus FulfillmentStatus @default(PENDIENTE)
  trackingCode      String?

  // --- Impuestos (snapshot del cálculo del checkout) ---
  taxAmount       Decimal @default(0) @db.Decimal(10, 2) // IVA incluido en total
  taxExempt       Boolean @default(false) // exportación: físicos sin IVA
  shippingTaxRate Decimal @default(21) @db.Decimal(5, 2)

  // --- Facturación ---
  billingName      String? // razón social / nombre para factura completa
  billingTaxId     String? // NIF/CIF/VAT del cliente (opcional)
  invoiceNumber    String?   @unique // se asigna al confirmarse el pago
  invoiceDate      DateTime?
  creditNoteNumber String?   @unique // factura rectificativa, al reembolsar
  creditNoteDate   DateTime?

  // --- Reembolso ---
  // refundedAt se marca ANTES de llamar a Stripe (reclama el reembolso): así un
  // doble click o el webhook charge.refunded que llega mientras tanto no lo
  // procesan dos veces. Si Stripe falla, se revierte a null.
  refundedAt     DateTime?
  stripeRefundId String?

  shippingMethod ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  discountCode   Discount?       @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  tickets        Ticket[]

  @@index([status])
  @@index([fulfillmentStatus])
  @@index([email])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String
  productVariantId  String
  quantity          Int
  // Precio unitario cobrado (IVA incluido; sin IVA si el pedido es de exportación).
  unitPrice         Decimal  @db.Decimal(10, 2)
  taxRate           Decimal  @default(21) @db.Decimal(5, 2)
  // Descuento del cupón prorrateado a esta línea (para la factura).
  discountAmount    Decimal  @default(0) @db.Decimal(10, 2)
  // Snapshot de la variante: la factura no cambia si luego se renombra.
  variantLabel      String   @default("")
  // Entradas nominativas: un nombre por unidad, en orden. Se copian a cada
  // Ticket al confirmarse el pago.
  attendeeNames     String[] @default([])
  // Documento (DNI/NIE/pasaporte) de cada asistente, en el mismo orden que los nombres.
  attendeeDocuments String[] @default([])

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  tickets        Ticket[]
}

// ----------------------------------------------------------------------------
// ENTRADAS NOMINALES (una fila por unidad vendida de un TICKET_EVENTO)
// ----------------------------------------------------------------------------

enum TicketStatus {
  VALIDA
  USADA
  ANULADA
}

// Se generan al confirmarse el pago (una por unidad). `code` es el secreto que
// va en el QR: aleatorio y no adivinable, se valida en puerta con el check-in.
model Ticket {
  id             String       @id @default(cuid())
  code           String       @unique
  status         TicketStatus @default(VALIDA)
  orderId        String
  orderItemId    String
  eventId        String
  holderEmail    String
  // Nombre del asistente (solo en eventos con entradas nominativas).
  holderName     String?
  // Documento del asistente (DNI/NIE/pasaporte), para cotejarlo en la puerta.
  // Solo se muestra completo en el panel y el check-in; al comprador, enmascarado.
  holderDocument String?
  checkedInAt    DateTime?
  checkedInById  String?
  createdAt      DateTime     @default(now())

  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  // Restrict: un evento con entradas vendidas no se puede borrar (se cancela).
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  checkedInBy User?     @relation(fields: [checkedInById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([eventId, status])
  // Un DNI por evento en entradas nominativas (assertDocumentsFreeForEvent).
  @@index([eventId, holderDocument])
}

// ----------------------------------------------------------------------------
// 7. COLABORACIONES Y BOOKINGS
// ----------------------------------------------------------------------------

enum BookingType {
  CONTRATACION
  COLABORACION
}

enum BookingStatus {
  NUEVA
  EN_REVISION
  ACEPTADA
  RECHAZADA
}

model Booking {
  id            String        @id @default(cuid())
  type          BookingType
  requesterName String
  email         String
  details       String        @db.Text
  status        BookingStatus @default(NUEVA)
  artistId      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  artist Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// Numeración correlativa de facturas por serie y año ("F2026", "R2026").
// Se incrementa con un UPSERT atómico dentro de la transacción del pago.
model InvoiceCounter {
  id   String @id
  last Int    @default(0)
}

// ----------------------------------------------------------------------------
// NEWSLETTER (suscripción con consentimiento explícito, RGPD)
// ----------------------------------------------------------------------------

enum NewsletterStatus {
  ACTIVO
  BAJA
}

model NewsletterSubscriber {
  id               String               @id @default(cuid())
  email            String               @unique
  status           NewsletterStatus     @default(ACTIVO)
  // Prueba del consentimiento: cuándo, desde dónde y en qué formulario.
  consentAt        DateTime
  consentIp        String?
  source           String               @default("newsletter")
  // Token del enlace "darse de baja" de cada email (no requiere login).
  unsubscribeToken String               @unique
  unsubscribedAt   DateTime?
  deliveries       NewsletterDelivery[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, createdAt])
}

// Campañas de newsletter redactadas y enviadas desde el panel.
enum NewsletterCampaignStatus {
  BORRADOR
  ENVIANDO
  ENVIADA
}

model NewsletterCampaign {
  id             String                   @id @default(cuid())
  subject        String
  // Texto corto que los clientes de correo muestran junto al asunto.
  preheader      String?
  heading        String
  // Contenido con formato mínimo: párrafos, "## subtítulo", listas "- ",
  // **negrita** y [enlace](https://...). Ver renderNewsletterBody.
  body           String                   @db.Text
  imageUrl       String?
  ctaLabel       String?
  ctaUrl         String?
  status         NewsletterCampaignStatus @default(BORRADOR)
  // Suscriptores activos en el momento de lanzar el envío.
  recipientCount Int                      @default(0)
  testSentAt     DateTime?
  startedAt      DateTime?
  sentAt         DateTime?
  // Publicada en el archivo de newsletter.html (null = no visible en la web).
  // Se pone al lanzar el envío; el panel también la publica o retira a mano.
  publishedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  deliveries NewsletterDelivery[]

  @@index([status, createdAt])
}

// Estado del envío de una campaña a cada suscriptor. Una fila por destinatario
// (única por campaña): así un envío interrumpido se reanuda sin duplicar correos.
enum NewsletterDeliveryStatus {
  PENDIENTE
  ENVIANDO
  ENVIADO
  FALLIDO
  // Se dio de baja entre el lanzamiento y su turno de envío.
  OMITIDO
}

model NewsletterDelivery {
  id           String                   @id @default(cuid())
  campaignId   String
  subscriberId String
  status       NewsletterDeliveryStatus @default(PENDIENTE)
  error        String?
  sentAt       DateTime?

  campaign   NewsletterCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([campaignId, subscriberId])
  @@index([campaignId, status])
}

// ----------------------------------------------------------------------------
// 8. LOGS DE AUDITORÍA
// ----------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
